# Puerto del servidor NestJS
PORT=3000

# Origen(es) permitido(s) por CORS, separados por coma (nunca usar "*")
CORS_ORIGIN=http://localhost:8081

# Postgres (Supabase Cloud por ahora; self-hosted en el VPS en el futuro)
# Dashboard de Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase Auth
# Dashboard de Supabase → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard de Supabase → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=

# Deep link al que Supabase redirige tras pulsar el enlace de "restablecer
# contraseña" en el email. Debe coincidir con el "scheme" de apps/mobile/app.json.
AUTH_RESET_PASSWORD_REDIRECT_URL=mobile://reset-password
